{
	"name": "Node.js Codespace",
	"image": "mcr.microsoft.com/devcontainers/javascript-node:18", // Specify Node.js version
	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {
			"installZsh": true,
    		"installOhMyZsh": true
		}
	},
    "customizations": {
    	"vscode": {
            "extensions": [
            	"dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode"
            ]
        }
	},
    "postCreateCommand": "npm install" // Install project dependencies
}
